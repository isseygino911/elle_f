# =============================================================================
# Student CRM — Client Environment Variable Contract
# =============================================================================
# Copy this file to `.env` (this same directory) for local dev, or
# `.env.production` before running `npm run build` for a production build.
# NEVER commit the real .env files — they are gitignored. This file
# documents NAMES and PURPOSE only; no real secrets belong here (this one
# isn't a secret, but the pattern is kept consistent with the API repo).
# =============================================================================

# Vite only exposes env vars prefixed VITE_ to the browser bundle.
# Points the React app at the Express API origin. This is the single source
# of truth for the API base URL on the client (src/api/client.js reads it
# once into API_BASE_URL and every request is built from that).
# Dev default matches the local Express server. Production value is the
# real API domain served by Caddy: https://arco-api.elleeliason.com
VITE_API_BASE_URL=http://localhost:4000
